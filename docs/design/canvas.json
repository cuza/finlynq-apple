    "portrait-about": {
      "x": 8100,
      "y": 0,
      "w": 340,
      "text": "iPad Air held upright with the sidebar open. The screen gets a 540pt column, so every view is one column of cards, and amounts never wrap.\n\nChrome is the system look (Liquid Glass on iPadOS 26): glass sidebar, toolbar buttons, segmented controls. Content cards stay opaque.\n\nSample values are the long CAD amounts that broke the app.",
      "fill": "blue",
      "size": "m",
      "page": "portrait"
    },
