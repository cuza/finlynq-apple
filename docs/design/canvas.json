      "page": "duo"
    },
    "duo-inner": {
      "x": 0,
      "y": 700,
      "text": "Open: inner display",
      "kind": "title1",
      "maxW": 5300,
      "page": "duo"
    },
    "duo-about": {
      "x": 3276,
      "y": 0,
      "w": 360,
      "text": "iPhone Duo, Apple's foldable (iOS 27.1+).\n\nClosed (466x678pt): the system moves tab bar, toolbar and back button into a rail on the right. Content runs beside it.\n\nOpen (669x951pt): horizontal bars in portrait; the rail in landscape. List and detail sit side by side.\n\nBook pose: content splits 50/50 around the fold.\n\nAll of this comes from system controls; the boards decide how content reflows.",
      "fill": "blue",
      "size": "m",
      "page": "duo"
    },
